        </mxCell>
        <mxCell id="9" parent="1" value="Lượt vừa rồi có&#10;cập nhật?" vertex="1" style="html=0;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontColor=#203F49;rhombus;strokeWidth=2;strokeColor=#995004;fillColor=#FFF2DF;fontSize=14;">
          <mxGeometry as="geometry" x="72" y="530" width="212" height="93" />
        </mxCell>
        <mxCell id="10" parent="1" value="Kiểm tra các cung còn có thể giảm nhãn từ nguồn. Đánh dấu đầu nhận của chúng." vertex="1" style="html=0;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontColor=#203F49;rounded=1;arcSize=14;strokeWidth=2;strokeColor=#637783;fillColor=#F2F6F7;fontSize=17;">
