        </mxCell>
        <mxCell id="7" parent="1" value="Đã đủ |V|−1 lượt?" vertex="1" style="html=0;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontColor=#203F49;rhombus;strokeWidth=2;strokeColor=#995004;fillColor=#FFF2DF;fontSize=14;">
          <mxGeometry as="geometry" x="76" y="305" width="203" height="76" />
        </mxCell>
        <mxCell id="8" parent="1" value="Quét trọn một lượt. Với u tới được,&#10;nếu d[u] + w &lt; d[v] thì cập nhật&#10;d[v], đỉnh trước và mã cung." vertex="1" style="html=0;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontColor=#203F49;rounded=1;arcSize=14;strokeWidth=2;strokeColor=#637783;fillColor=#E0F3EA;fontSize=17;">
