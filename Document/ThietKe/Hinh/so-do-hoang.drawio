        <mxCell id="3" parent="1" value="Từ nới lỏng đến phát hiện chu trình âm" vertex="1" style="html=0;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontColor=#203F49;text;align=left;fontSize=30;fontStyle=1;">
          <mxGeometry as="geometry" x="40" y="22" width="920" height="52" />
        </mxCell>
        <mxCell id="4" parent="1" value="Mỗi lượt duyệt toàn bộ cung theo thứ tự đầu vào. Cập nhật ngay khi tìm được chi phí nhỏ hơn." vertex="1" style="html=0;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontColor=#203F49;text;align=left;fontSize=15;">
          <mxGeometry as="geometry" x="42" y="79" width="918" height="42" />
        </mxCell>
        <mxCell id="5" parent="1" value="Kiểm tra đồ thị và đỉnh nguồn" vertex="1" style="html=0;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontColor=#203F49;rounded=1;arcSize=14;strokeWidth=2;strokeColor=#637783;fillColor=#F2F6F7;fontSize=17;">
