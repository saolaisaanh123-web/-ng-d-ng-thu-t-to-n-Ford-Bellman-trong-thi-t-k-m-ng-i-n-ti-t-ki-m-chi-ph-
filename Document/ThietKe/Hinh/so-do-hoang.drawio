        </mxCell>
        <mxCell id="11" parent="1" value="Từ đỉnh đã đánh dấu, duyệt theo các cung đi. Các đích tới được có phí không bị chặn dưới." vertex="1" style="html=0;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontColor=#203F49;rounded=1;arcSize=14;strokeWidth=2;strokeColor=#637783;fillColor=#F2F6F7;fontSize=17;">
          <mxGeometry as="geometry" x="475" y="265" width="460" height="78" />
        </mxCell>
        <mxCell id="12" parent="1" value="Chọn đích. Tra trạng thái nhãn và tiền nhiệm đã tính." vertex="1" style="html=0;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontColor=#203F49;rounded=1;arcSize=14;strokeWidth=2;strokeColor=#637783;fillColor=#F2F6F7;fontSize=17;">
          <mxGeometry as="geometry" x="475" y="387" width="460" height="65" />
        </mxCell>
        <mxCell id="13" parent="1" value="Hữu hạn: truy ngược mã cung.&#10;Cô lập: báo không có đường.&#10;Ảnh hưởng âm: cảnh báo chi phí giảm vô hạn." vertex="1" style="html=0;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontColor=#203F49;rounded=1;arcSize=14;strokeWidth=2;strokeColor=#637783;fillColor=#E0F3EA;fontSize=17;">
