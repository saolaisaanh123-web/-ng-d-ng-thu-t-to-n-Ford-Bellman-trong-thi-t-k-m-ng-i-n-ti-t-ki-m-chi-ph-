        </mxCell>
        <mxCell id="6" parent="1" value="d[S] ← 0&#10;đỉnh khác ← ∞" vertex="1" style="html=0;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontColor=#203F49;rounded=1;arcSize=14;strokeWidth=2;strokeColor=#637783;fillColor=#F2F6F7;fontSize=17;">
